# GitHub Linguist overrides
# https://github.com/github-linguist/linguist/blob/master/docs/overrides.md
#
# This is an Assembly + C project. The kernel is src/kernel_avx2.asm; the C
# shim, CPUID dispatch and header are the ABI around it. Everything in Python
# is either a thin ctypes binding or test/build/benchmark tooling, so it is
# excluded from the language bar. Use globs so new tooling files are covered.

# Core deliverables: counted
src/**       linguist-detectable=true
include/**   linguist-detectable=true

# ctypes binding layer: thin glue around the C ABI, not the implementation
flashspec_asm_kernel/**   linguist-detectable=false
bindings/**               linguist-detectable=false

# Correctness infrastructure: reference op, pytest suite, C fuzz harness
reference/**   linguist-documentation=true
tests/**       linguist-documentation=true

# Build, packaging, CI and benchmark tooling
scripts/**     linguist-vendored=true
bench/**       linguist-vendored=true
setup.py       linguist-vendored=true
build_wheel.py linguist-vendored=true

# Docs
docs/**   linguist-documentation=true
